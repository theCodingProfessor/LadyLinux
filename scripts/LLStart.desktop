[Desktop Entry]
Version=1.0
Type=Application
Name=LadyLinux Start
Comment=Launch the LadyLinux LLM system
Exec=bash -lc 'if [ ! -x /opt/ladylinux/scripts/system_run.sh ]; then chmod +x /opt/ladylinux/scripts/system_start.sh; fi; exec /opt/ladylinux/scripts/system_run.sh'
Icon=system-run
Terminal=true
Categories=Utility;System;
Keywords=ladylinux;start;launch;
X-Desktop-File-Install-Version=0.26
